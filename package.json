{
  "name": "editor-filter",
  "publisher": "local",
  "displayName": "Line Filter Prototype",
  "description": "Throwaway prototype for writable filtered virtual documents.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "enabledApiProposals": [
    "editorInsets"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sift-typescript",
        "aliases": [
          "Sift TypeScript"
        ],
        "configuration": "./syntaxes/typescript-language-configuration.json"
      },
      {
        "id": "sift-typescriptreact",
        "aliases": [
          "Sift TypeScript JSX"
        ],
        "configuration": "./syntaxes/typescript-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sift-typescript",
        "scopeName": "source.sift.typescript",
        "path": "./syntaxes/sift-typescript.tmLanguage.json",
        "unbalancedBracketScopes": [
          "keyword.operator.relational",
          "storage.type.function.arrow",
          "keyword.operator.bitwise.shift",
          "meta.brace.angle",
          "punctuation.definition.tag",
          "keyword.operator.assignment.compound.bitwise.ts"
        ],
        "tokenTypes": {
          "punctuation.definition.template-expression": "other",
          "entity.name.type.instance.jsdoc": "other",
          "entity.name.function.tagged-template": "other",
          "meta.import string.quoted": "other",
          "variable.other.jsdoc": "other"
        }
      },
      {
        "language": "sift-typescriptreact",
        "scopeName": "source.sift.typescriptreact",
        "path": "./syntaxes/sift-typescriptreact.tmLanguage.json",
        "unbalancedBracketScopes": [
          "keyword.operator.relational",
          "storage.type.function.arrow",
          "keyword.operator.bitwise.shift",
          "punctuation.definition.tag",
          "keyword.operator.assignment.compound.bitwise.ts"
        ],
        "embeddedLanguages": {
          "meta.tag.tsx": "jsx-tags",
          "meta.tag.without-attributes.tsx": "jsx-tags",
          "meta.tag.attributes.tsx": "sift-typescriptreact",
          "meta.embedded.expression.tsx": "sift-typescriptreact"
        },
        "tokenTypes": {
          "punctuation.definition.template-expression": "other",
          "entity.name.type.instance.jsdoc": "other",
          "entity.name.function.tagged-template": "other",
          "meta.import string.quoted": "other",
          "variable.other.jsdoc": "other"
        }
      }
    ],
    "commands": [
      {
        "command": "editor-filter.filterThisFile",
        "title": "Filter Lines: Filter This File"
      },
      {
        "command": "editor-filter.searchProject",
        "title": "Filter Lines: Search Project with fff"
      },
      {
        "command": "editor-filter.changeFilter",
        "title": "Filter Lines: Change Filter"
      },
      {
        "command": "editor-filter.openSource",
        "title": "Filter Lines: Open Source Location"
      },
      {
        "command": "editor-filter.showState",
        "title": "Filter Lines: Show Prototype State"
      }
    ],
    "keybindings": [
      {
        "command": "editor-filter.openSource",
        "key": "cmd+enter",
        "mac": "cmd+enter",
        "when": "resourceScheme == linefilter"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "typecheck": "tsc -p ./ --noEmit",
    "compile": "pnpm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "prototype": "pnpm run compile && code --enable-proposed-api local.editor-filter --new-window --extensionDevelopmentPath=\"$PWD\" \"$PWD\"",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "node --test out/test/*.unit.js && vscode-test",
    "test:unit": "pnpm run compile && node --test out/test/*.unit.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@ff-labs/fff-node": "^0.10.0"
  }
}
