{
  "name": "sift",
  "publisher": "local",
  "displayName": "Sift",
  "description": "Sift editors and projects into focused, editable views.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "enabledApiProposals": [
    "editorInsets"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:sift-editor",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sift-typescript",
        "aliases": [
          "Sift TypeScript"
        ]
      },
      {
        "id": "sift-typescriptreact",
        "aliases": [
          "Sift TypeScript JSX"
        ]
      }
    ],
    "grammars": [
      {
        "language": "sift-typescript",
        "scopeName": "source.sift.typescript",
        "path": "./syntaxes/sift-typescript.tmLanguage.json"
      },
      {
        "language": "sift-typescriptreact",
        "scopeName": "source.sift.typescriptreact",
        "path": "./syntaxes/sift-typescriptreact.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[sift-typescript]": {
        "editor.guides.indentation": false,
        "editor.guides.highlightActiveIndentation": false
      },
      "[sift-typescriptreact]": {
        "editor.guides.indentation": false,
        "editor.guides.highlightActiveIndentation": false
      }
    },
    "commands": [
      {
        "command": "sift.siftEditor",
        "title": "Sift Editor"
      },
      {
        "command": "sift.siftProject",
        "title": "Sift Project"
      },
      {
        "command": "sift.siftPaths",
        "title": "Sift Paths"
      }
    ],
    "keybindings": [
      {
        "command": "sift.save",
        "key": "cmd+s",
        "when": "resourceScheme == sift-editor && editorTextFocus"
      },
      {
        "command": "sift.cursorUpOrFocusQuery",
        "key": "up",
        "when": "resourceScheme == sift-editor && editorTextFocus"
      },
      {
        "command": "sift.openSource",
        "key": "cmd+enter",
        "when": "resourceScheme == sift-editor && editorTextFocus"
      },
      {
        "command": "sift.openSource",
        "key": "enter",
        "when": "resourceScheme == sift-editor && editorTextFocus"
      },
      {
        "command": "sift.close",
        "key": "escape",
        "when": "resourceScheme == sift-editor && editorTextFocus && !editorHasMultipleSelections"
      },
      {
        "command": "runCommands",
        "key": "cmd+up",
        "when": "resourceScheme == sift-editor && editorTextFocus",
        "args": {
          "commands": [
            "cursorTop",
            "sift.focusQueryInput"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "typecheck": "tsc -p ./ --noEmit",
    "compile": "pnpm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "dev": "pnpm run compile && code --enable-proposed-api local.sift --new-window --extensionDevelopmentPath=\"$PWD\" \"$PWD\"",
    "enable-proposed-api": "node scripts/enable-proposed-api.mjs",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "node --test out/test/*.unit.js scripts/*.test.mjs && vscode-test",
    "test:unit": "pnpm run compile && node --test out/test/*.unit.js scripts/*.test.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "jsonc-parser": "^3.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@ff-labs/fff-node": "^0.10.0"
  }
}
